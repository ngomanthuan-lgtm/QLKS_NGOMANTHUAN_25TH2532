@model QLKS_NGOMANTHUAN_25TH2532.Models.Dichvu25th2532
@{
    ViewData["Title"] = "Thêm Dịch vụ";
}
<h1>Thêm mới Dịch vụ</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="TenDichVu" class="control-label">Tên Dịch Vụ</label>
                <input asp-for="TenDichVu" class="form-control" />
                <span asp-validation-for="TenDichVu" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="GiaDichVu" class="control-label">Giá Dịch Vụ</label>
                <input asp-for="GiaDichVu" class="form-control" />
                <span asp-validation-for="GiaDichVu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Thêm mới" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>
