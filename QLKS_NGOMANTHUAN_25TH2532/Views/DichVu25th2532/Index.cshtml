@model IEnumerable<QLKS_NGOMANTHUAN_25TH2532.Models.Dichvu25th2532>
@{
    ViewData["Title"] = "Danh sách Dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách Dịch vụ Khách sạn</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Thêm dịch vụ mới</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Mã Dịch Vụ</th>
            <th>Tên Dịch Vụ</th>
            <th>Giá Dịch Vụ</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.MaDichVu)</td>
                <td>@Html.DisplayFor(modelItem => item.TenDichVu)</td>
                <td class="text-success fw-medium">@string.Format("{0:N0} đ", item.GiaDichVu)</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.MaDichVu" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i> Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.MaDichVu" class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.MaDichVu" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
