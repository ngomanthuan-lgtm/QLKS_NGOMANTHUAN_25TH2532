@model QLKS_NGOMANTHUAN_25TH2532.Models.Dichvu25th2532

@{
    ViewData["Title"] = "Chi tiết dịch vụ";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0"><i class="bi bi-info-circle-fill"></i> Chi Tiết Thông Tin Dịch Vụ</h3>
        </div>
        <div class="card-body">
            <dl class="row font-medium" style="font-size: 1.1rem; line-height: 2;">
                <dt class="col-sm-3 text-muted">Mã dịch vụ:</dt>
                <dd class="col-sm-9 fw-bold text-dark">@Model.MaDichVu</dd>

                <dt class="col-sm-3 text-muted">Tên dịch vụ:</dt>
                <dd class="col-sm-9 fw-bold text-dark">@Model.TenDichVu</dd>

                <dt class="col-sm-3 text-muted">Giá dịch vụ:</dt>
                <dd class="col-sm-9 text-danger fw-bold">@string.Format("{0:N0} VNĐ", Model.GiaDichVu)</dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaDichVu" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>
