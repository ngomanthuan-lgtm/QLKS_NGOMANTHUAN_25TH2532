@model IEnumerable<QLKS_NGOMANTHUAN_25TH2532.Models.Phong25th2532>

@{
    ViewData["Title"] = "Danh sách Phòng";
}

<h1>Danh sách Phòng khách sạn</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới Phòng</a>
</p>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã Phòng</th>
            <th>Số Phòng</th>
            <th>Loại Phòng</th>
            <th>Trạng Thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MaPhong)</td>
                <td>@Html.DisplayFor(modelItem => item.SoPhong)</td>
                <td>@Html.DisplayFor(modelItem => item.MaLoaiPhongNavigation.TenLoaiPhong)</td>
                <td>@Html.DisplayFor(modelItem => item.MaTrangThaiNavigation.TenTrangThai)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaPhong" class="btn btn-sm btn-warning">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.MaPhong" class="btn btn-sm btn-info">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaPhong" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
