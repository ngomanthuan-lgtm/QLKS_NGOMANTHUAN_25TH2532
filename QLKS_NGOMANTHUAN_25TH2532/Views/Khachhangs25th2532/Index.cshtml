@model IEnumerable<QLKS_NGOMANTHUAN_25TH2532.Models.Khachhang25th2532>
@{
    ViewData["Title"] = "Danh sách Khách hàng";
}
<h1>Danh sách Hồ sơ Khách hàng</h1>
<p><a asp-action="Create" class="btn btn-primary">Thêm Khách hàng</a></p>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã KH</th>
            <th>Họ Tên</th>
            <th>Số Điện Thoại</th>
            <th>Email</th>
            <th>Số CCCD</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MaKhachHang)</td>
                <td>@Html.DisplayFor(modelItem => item.HoTen)</td>
                <td>@Html.DisplayFor(modelItem => item.SoDienThoai)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.SoCCCD)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-warning">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-info">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
