@model QLKS_NGOMANTHUAN_25TH2532.Models.Khuyenmai25th2532
@{
    ViewData["Title"] = "Tạo mới Khuyến mãi";
}
<h1>Tạo mới Khuyến mãi</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="TenKhuyenMai" class="control-label">Tên Khuyến Mãi</label>
                <input asp-for="TenKhuyenMai" class="form-control" />
                <span asp-validation-for="TenKhuyenMai" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NgayBatDau" class="control-label">Ngày Bắt Đầu</label>
                <input asp-for="NgayBatDau" class="form-control" type="datetime-local" />
                <span asp-validation-for="NgayBatDau" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NgayKetThuc" class="control-label">Ngày Kết Thúc</label>
                <input asp-for="NgayKetThuc" class="form-control" type="datetime-local" />
                <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu Lại" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>
