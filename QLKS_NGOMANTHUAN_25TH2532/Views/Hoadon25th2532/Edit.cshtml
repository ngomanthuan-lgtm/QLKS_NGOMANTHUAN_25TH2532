@model QLKS_NGOMANTHUAN_25TH2532.Models.Hoadon25th2532

@{
    ViewData["Title"] = "Chỉnh sửa hóa đơn";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h3 class="card-title mb-0"><i class="bi bi-pencil-square"></i> Cập Nhật Thông Tin Hóa Đơn</h3>
        </div>
        <form asp-action="Edit">
            <div class="card-body row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="MaHoaDon" />

                <div class="col-md-6">
                    <label asp-for="NgayLap" class="form-label fw-bold">Ngày Lập</label>
                    <input asp-for="NgayLap" class="form-label form-control" type="datetime-local" />
                    <span asp-validation-for="NgayLap" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaChiTietDat" class="form-label fw-bold">Mã Chi Tiết Đặt</label>
                    <input asp-for="MaChiTietDat" class="form-control" type="number" readonly />
                </div>

                <div class="col-md-4">
                    <label asp-for="TongTienPhong" class="form-label fw-bold">Tiền Phòng (VNĐ)</label>
                    <input asp-for="TongTienPhong" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="TongTienPhong" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TongTienDichVu" class="form-label fw-bold">Tiền Dịch Vụ (VNĐ)</label>
                    <input asp-for="TongTienDichVu" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="TongTienDichVu" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ThanhTien" class="form-label fw-bold">Thành Tiền (VNĐ)</label>
                    <input asp-for="ThanhTien" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="ThanhTien" class="text-danger"></span>
                </div>
            </div>
            <div class="card-footer bg-light d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="bi bi-save-fill"></i> Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
