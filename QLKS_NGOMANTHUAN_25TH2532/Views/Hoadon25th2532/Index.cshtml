@model IEnumerable<QLKS_NGOMANTHUAN_25TH2532.Models.Hoadon25th2532>
@{
    ViewData["Title"] = "Danh sách Hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách Hóa đơn</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-file-earmark-plus-fill"></i> Tạo mới Hóa đơn</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Mã Hóa Đơn</th>
            <th>Ngày Lập</th>
            <th>Tiền Phòng</th>
            <th>Tiền Dịch Vụ</th>
            <th>Thành Tiền</th>
            <th>Mã Chi Tiết Đặt</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.MaHoaDon)</td>
                <td><i class="bi bi-clock text-muted"></i> @Html.DisplayFor(modelItem => item.NgayLap)</td>
                <td>@string.Format("{0:N0} đ", item.TongTienPhong)</td>
                <td>@string.Format("{0:N0} đ", item.TongTienDichVu)</td>
                <td class="text-danger fw-bold">@string.Format("{0:N0} đ", item.ThanhTien)</td>
                <td><span class="badge bg-light text-dark border">#@item.MaChiTietDatNavigation?.MaChiTietDat</span></td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.MaHoaDon" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i> Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.MaHoaDon" class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.MaHoaDon" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
