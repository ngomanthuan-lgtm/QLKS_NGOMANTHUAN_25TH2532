@model QLKS_NGOMANTHUAN_25TH2532.Models.Hoadon25th2532

@{
    ViewData["Title"] = "Xóa hóa đơn";
}

<div class="container mt-4">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h3 class="card-title mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Xác Nhận Xóa Hóa Đơn</h3>
        </div>
        <div class="card-body">
            <h4 class="text-danger mb-4">Bạn có chắc chắn muốn xóa hóa đơn này không? Hành động này sẽ loại bỏ dữ liệu doanh thu vĩnh viễn!</h4>

            <dl class="row font-medium" style="font-size: 1.1rem; line-height: 2;">
                <dt class="col-sm-4 text-muted">Mã hóa đơn:</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model.MaHoaDon</dd>

                <dt class="col-sm-4 text-muted">Ngày lập:</dt>
                <dd class="col-sm-8 text-dark">@string.Format("{0:dd/MM/yyyy HH:mm}", Model.NgayLap)</dd>

                <dt class="col-sm-4 text-muted">Thành tiền:</dt>
                <dd class="col-sm-8 text-danger fw-bold">@string.Format("{0:N0} VNĐ", Model.ThanhTien)</dd>
            </dl>
        </div>
        <div class="card-footer bg-light">
            <form asp-action="Delete">
                <input type="hidden" asp-for="MaHoaDon" />
                <button type="submit" class="btn btn-danger me-2">
                    <i class="bi bi-trash-fill"></i> Xác nhận xóa
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Hủy bỏ
                </a>
            </form>
        </div>
    </div>
</div>
