@model IEnumerable<QLKS_NGOMANTHUAN_25TH2532.Models.Datphong25th2532>
@{
    ViewData["Title"] = "Danh sách Đặt phòng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách Phiếu Đặt Phòng</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-calendar-plus-fill"></i> Tạo phiếu đặt phòng
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Mã Đặt</th>
            <th>Khách Đặt</th>
            <th>Liên Hệ</th>
            <th>Ngày Đặt</th>
            <th>Tiền Cọc</th>
            <th>Tình Trạng</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.MaDatPhong)</td>
                <td>
                    <div class="fw-medium text-dark">
                        @(string.IsNullOrEmpty(item.HoTenNguoiDat) ? "Chưa cập nhật" : item.HoTenNguoiDat)
                    </div>
                    <small class="text-muted">
                        NS: @(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "---")
                    </small>
                </td>
                <td>
                    <div><i class="bi bi-telephone text-muted"></i> @(string.IsNullOrEmpty(item.SoDienThoai) ? "---" : item.SoDienThoai)</div>
                    <small class="text-muted">@(string.IsNullOrEmpty(item.Email) ? "" : item.Email)</small>
                </td>
                <td><i class="bi bi-calendar3 text-muted"></i> @Html.DisplayFor(modelItem => item.NgayDat)</td>
                <td class="text-success fw-medium">
                    @(item.TienDatCoc.HasValue ? string.Format("{0:N0} đ", item.TienDatCoc.Value) : "0 đ")
                </td>
                <td><span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.TinhTrangDat)</span></td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil-square"></i> Sửa
                    </a>
                    <a asp-action="Details" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Chi tiết
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
