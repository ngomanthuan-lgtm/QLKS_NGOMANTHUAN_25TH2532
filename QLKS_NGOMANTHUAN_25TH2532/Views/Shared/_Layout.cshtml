<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Royal Hotel Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Tích hợp thư viện Bootstrap Icons hiện đại -->
    <link rel="stylesheet" href="https://jsdelivr.net" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building-fill-check text-warning"></i> ROYAL HOTEL
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="CHINHANH25th2532" asp-action="Index"><i class="bi bi-geo-alt"></i> Chi nhánh</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Phong25th2532" asp-action="Index"><i class="bi bi-door-open"></i> Phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Khachhangs25th2532" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Nhanviens25th2532" asp-action="Index"><i class="bi bi-person-badge"></i> Nhân viên</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DatPhong25th2532" asp-action="Index"><i class="bi bi-calendar-check"></i> Đặt phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DichVu25th2532" asp-action="Index"><i class="bi bi-cone-striped"></i> Dịch vụ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Hoadon25th2532" asp-action="Index"><i class="bi bi-receipt"></i> Hóa đơn</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PHUTHU25th2532" asp-action="Index"><i class="bi bi-cash-coin"></i> Phụ thu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Khuyenmais25th2532" asp-action="Index"><i class="bi bi-tags"></i> Khuyến mãi</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 px-md-5">
        <main role="main" class="pb-5">
            <div class="table-responsive-custom">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="footer footer-custom text-muted py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - <span class="text-dark fw-semibold">NGÔ MẪN THUẬN - 25TH2532</span> - ⚜️ Royal Hotel Premium System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
